# Server
PORT=3000
HOST=127.0.0.1

# Claude Code binary path (defaults to 'claude' on PATH)
CLAUDE_PATH=claude

# Working directory for the spawned claude process (defaults to proxy's cwd)
# CLAUDE_CWD=/path/to/project

# ── Claude Code CLI parameters ───────────────────────────────────────────────
# Model to use (e.g. claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-sonnet-4-6

# Comma-separated extra directories to allow claude to access
# CLAUDE_ADD_DIR=/path/to/dir1,/path/to/dir2

# Comma-separated list of allowed tool names
# CLAUDE_ALLOWED_TOOLS=Bash,Read,Write,Edit

# Comma-separated list of disallowed tool names
# CLAUDE_DISALLOWED_TOOLS=WebSearch,WebFetch

# Override system prompt
# CLAUDE_SYSTEM_PROMPT=You are a helpful assistant.

# Append to the default system prompt
# CLAUDE_APPEND_SYSTEM_PROMPT=Always respond in JSON.

# Skip all permission prompts (use with caution)
# CLAUDE_SKIP_PERMISSIONS=false

# Maximum number of agentic turns per request
# CLAUDE_MAX_TURNS=10

# Raw extra CLI args (space-separated, passed verbatim after the above flags)
# CLAUDE_ARGS=--verbose

# ── PTY terminal dimensions ──────────────────────────────────────────────────
# Wide columns prevent long prompts from wrapping (each wrap triggers a full
# TUI re-render which hides the status bar and slows echo to ~25 bytes/s).
# At 4096 cols even a 1500-char prompt fits on one visual row.
# PTY_COLS=4096
# PTY_ROWS=200

# ── Timing & behaviour ───────────────────────────────────────────────────────
CLAUDE_TIMEOUT_MS=120000
SESSION_TTL_MS=600000
PROMPT_DEBOUNCE_MS=300

# Logging
DEBUG=false
PTY_DEBUG=false
